# Neon Postgres — see https://neon.com/docs/guides/prisma
#
# Runtime (app / Prisma Client): pooled connection — hostname MUST contain "-pooler"
# On Vercel, use the pooled URL for DATABASE_URL only (never the direct URL at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# CLI only (npm run db:push, db:migrate): direct connection — no "-pooler" in hostname
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
#
# Local development: create a Neon "dev" branch and point .env.local at it.
# Do not run `npm run dev` or `npm run db:studio` against the production database —
# every page refresh keeps Neon compute active and wastes free-tier hours.
# Uptime monitors should hit /api/health (no DB). Never poll /api/health?db=1.

# Admin auth (required in production)
JWT_SECRET="generate-a-long-random-string"

# Admin seed credentials (used by `npm run db:seed` only)
ADMIN_EMAIL="admin@vitaglowproducts.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://vitaglowproducts.com"

# Brand logo (Cloudinary CDN)
NEXT_PUBLIC_LOGO_URL="https://res.cloudinary.com/rzkuraxy/image/upload/v1786447739/logoVitaglow.png"

# Contact / site info (optional — defaults exist in src/lib/site.ts)
# NEXT_PUBLIC_EMAIL="info@thevitaglowcosmetics.com"
# NEXT_PUBLIC_PHONE="+971562717889"
# NEXT_PUBLIC_PHONE_DISPLAY="+971 56 271 7889"
# NEXT_PUBLIC_WHATSAPP="971562717889"

# Contact form via Web3Forms (optional)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"
# After adding the key, enable hCaptcha in Web3Forms dashboard → your form → Spam Protection.
# Optional custom hCaptcha site key (paid Web3Forms plans only):
# NEXT_PUBLIC_HCAPTCHA_SITEKEY="your-hcaptcha-site-key"

# Cloudinary image hosting (recommended for Vercel / serverless)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
